# Copy to .env (git-ignored). `make run-*` targets load it automatically.
# API keys are tenant:role:secret (role = ingest | read). Secrets must be >= 16 chars.
# Generate real ones with: openssl rand -hex 24
API_KEYS=demo:ingest:demo-ingest-key-change-me,demo:read:demo-read-key-change-me-0

# Used by the load generator and the dashboard dev server.
LOADGEN_INGEST_KEY=demo-ingest-key-change-me
LOADGEN_READ_KEY=demo-read-key-change-me-0
VITE_READ_KEY=demo-read-key-change-me-0

KAFKA_BROKERS=localhost:19092
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics-local-only

ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8088
LOG_LEVEL=info
# Uncomment to send traces to Jaeger (http://localhost:16686).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
